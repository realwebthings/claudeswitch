#!/bin/bash
# claudeswitch — switch between multiple Claude Code accounts without re-running
# /login every time.
#
#   claudeswitch save <name>     park the logged-in account under a slot name
#   claudeswitch use <name>      make a parked slot the active account
#   claudeswitch list            show parked slots and which is active
#   claudeswitch whoami          show the active account
#   claudeswitch rm <name>       delete a parked slot
#   claudeswitch install-shim    make this command available outside Claude Code
#
# Run install-shim once after installing the plugin. Claude Code only puts a
# plugin's bin/ on PATH inside its own sessions, but switching accounts requires
# Claude Code to be quit — so the command must work in a plain terminal too.
#
# Why this is needed
# ------------------
# Logging in writes TWO pieces of state, and both must be swapped together:
#
#   1. OAuth tokens — one macOS Keychain entry:
#        service "Claude Code-credentials", account "$USER"
#      /login overwrites it, destroying whichever account was there before.
#
#   2. The displayed identity — the "oauthAccount" key in ~/.claude.json.
#      Swap only the token and the UI keeps showing the previous email while
#      requests authenticate as the new account.
#
# Neither is scoped by CLAUDE_CONFIG_DIR: that env var swaps settings, plugins
# and history, but every config dir shares one Keychain slot and one
# ~/.claude.json. So this script parks each account's token in its own Keychain
# slot plus an identity file, and copies the pair you want into place on demand.
#
#   "Claude Code-credentials"          <- active; Claude Code reads only this
#   "Claude Code-credentials-<name>"   <- parked copy, survives /login
#   ~/.claude-accounts/<name>.oauthAccount.json
#
# Both parts are unofficial internals. A Claude Code update could rename either,
# so this script verifies what it finds and refuses to act on surprises rather
# than half-applying a switch.
#
# Requires: macOS (security), python3, curl.

set -euo pipefail

LIVE_SVC="Claude Code-credentials"
ACCT="${USER}"
GLOBAL_JSON="${HOME}/.claude.json"
PARK_DIR="${HOME}/.claude-accounts"
PROFILE_URL="https://api.anthropic.com/api/oauth/profile"

die() { echo "claudeswitch: $*" >&2; exit 1; }

# ---------------------------------------------------------------- preflight ---

require_deps() {
  command -v security >/dev/null 2>&1 || die "'security' not found — this script is macOS-only"
  command -v python3  >/dev/null 2>&1 || die "python3 not found"
  command -v curl     >/dev/null 2>&1 || die "curl not found"
}

# --------------------------------------------------------------- sessions -----

# Live Claude Code PIDs, excluding this script's own ancestors. Without the
# ancestor filter, running from inside a Claude Code session would always
# detect itself and refuse.
running_session_pids() {
  local pids="" p mine=""
  p=$$
  while [ -n "$p" ] && [ "$p" != "1" ]; do
    mine="$mine $p"
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
  # Covers the VSCode/JetBrains extension (native-binary/claude), a CLI install
  # on PATH (/claude), and the desktop app (Claude.app). Anything that holds the
  # credential open needs to be caught here, whichever way Claude Code was
  # installed — the CLI is not required for this tool to work.
  for p in $(pgrep -f 'native-binary/claude|/claude$|Claude\.app' 2>/dev/null || true); do
    case " $mine " in *" $p "*) continue ;; esac
    pids="$pids $p"
  done
  echo "$pids" | tr -s ' ' | sed 's/^ //;s/ $//'
}

warn_other_sessions() {
  local pids; pids="$(running_session_pids)"
  [ -z "$pids" ] && return 0
  echo "claudeswitch: warning — other Claude Code sessions running (pid: $pids)." >&2
  echo "  They rewrite the active credential on token refresh. If a switch" >&2
  echo "  seems to revert, quit them and retry." >&2
}

# `use` overwrites the active credential, so a live session would fight it.
assert_safe_to_switch() {
  [ -n "${CLAUDESWITCH_FORCE:-}" ] && return 0
  local pids; pids="$(running_session_pids)"
  [ -z "$pids" ] && return 0
  echo "claudeswitch: refusing to switch — other Claude Code sessions are running (pid: $pids)." >&2
  echo "  A live session rewrites the credential on token refresh and would" >&2
  echo "  revert this switch. Quit them, then retry." >&2
  echo "  To override: CLAUDESWITCH_FORCE=1 claudeswitch use <name>" >&2
  exit 1
}

# ------------------------------------------------------------- credentials ----

read_live() {
  security find-generic-password -s "$LIVE_SVC" -a "$ACCT" -w 2>/dev/null \
    || die "no active credential found — open Claude Code and run /login first"
}

write_slot() {
  # -U updates in place when the item already exists
  security add-generic-password -U -s "$1" -a "$ACCT" -w "$2"
}

slot_names() {
  security dump-keychain 2>/dev/null \
    | grep '"svce"' \
    | sed -n 's/.*"svce"<blob>="'"$LIVE_SVC"'-\(.*\)"/\1/p' \
    | sort -u
}

# Resolve a credential blob to its account email via the API. Accounts in the
# same organization share an organizationUuid, so the email is the only
# reliable way to tell slots apart. Prints nothing on failure.
identify() {
  local tok
  tok="$(printf '%s' "$1" \
    | python3 -c 'import sys,json;print(json.load(sys.stdin)["claudeAiOauth"]["accessToken"])' 2>/dev/null)" \
    || return 0
  [ -n "$tok" ] || return 0
  curl -s --max-time 10 \
    -H "Authorization: Bearer $tok" \
    -H "anthropic-beta: oauth-2025-04-20" \
    "$PROFILE_URL" 2>/dev/null \
    | python3 -c 'import sys,json;print(json.load(sys.stdin)["account"]["email"])' 2>/dev/null \
    || return 0
}

json_email() {
  python3 -c '
import json, sys
try:
    print(json.load(open(sys.argv[1])).get("oauthAccount", {}).get("emailAddress", ""))
except Exception:
    print("")
' "$GLOBAL_JSON" 2>/dev/null || true
}

summarize() {
  local data email
  data="$(cat)"
  email="$(identify "$data")"
  [ -n "$email" ] && echo "  account:  $email"
  printf '%s' "$data" | python3 -c '
import sys, json, datetime
try:
    d = json.load(sys.stdin)
except Exception:
    print("  (unparseable credential)"); sys.exit()
o = d.get("claudeAiOauth", {})
def ts(ms):
    return datetime.datetime.fromtimestamp(ms/1000).strftime("%Y-%m-%d %H:%M") if ms else "?"
print("  plan:    ", o.get("subscriptionType", "?"), "/", o.get("rateLimitTier", "?"))
print("  access:  ", ts(o.get("expiresAt")))
print("  refresh: ", ts(o.get("refreshTokenExpiresAt")))
'
}

# ---------------------------------------------------------------- identity ----

save_identity() {
  local name="$1"
  [ -f "$GLOBAL_JSON" ] || { echo "  (no ~/.claude.json — identity not parked)"; return 0; }
  mkdir -p "$PARK_DIR"
  python3 - "$GLOBAL_JSON" "$PARK_DIR/$name.oauthAccount.json" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
acct = d.get("oauthAccount")
if not acct:
    print("  (no oauthAccount key in ~/.claude.json — identity not parked)")
    sys.exit(0)
json.dump(acct, open(sys.argv[2], "w"), indent=2)
PY
}

# Rewrite one key in ~/.claude.json. That file also holds project history and
# MCP state, so back it up and replace atomically.
restore_identity() {
  local name="$1" parked="$PARK_DIR/$name.oauthAccount.json"
  if [ ! -f "$parked" ]; then
    echo "  warning: no parked identity for '$name' — the UI may still show the previous email."
    echo "           log in as that account and run 'claudeswitch save $name' to fix."
    return 0
  fi
  [ -f "$GLOBAL_JSON" ] || { echo "  warning: ~/.claude.json missing — identity not restored"; return 0; }
  cp "$GLOBAL_JSON" "${GLOBAL_JSON}.claudeswitch.bak"
  python3 - "$GLOBAL_JSON" "$parked" <<'PY'
import json, os, sys
target, parked = sys.argv[1], sys.argv[2]
d = json.load(open(target))
d["oauthAccount"] = json.load(open(parked))
tmp = target + ".claudeswitch.tmp"
with open(tmp, "w") as f:
    json.dump(d, f, indent=2)
os.replace(tmp, target)
PY
}

# ---------------------------------------------------------------- commands ----

usage() {
  sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "Run 'claudeswitch help' for the full explanation."
}

require_deps
cmd="${1:-}"; shift || true

case "$cmd" in
  save)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch save <name>"
    case "$name" in *[!A-Za-z0-9._-]*) die "slot name may only contain letters, digits, dot, dash, underscore" ;; esac
    warn_other_sessions
    data="$(read_live)"

    # The token and ~/.claude.json can disagree if a session refreshed the
    # token behind our back. Parking that would mislabel the slot.
    tok_email="$(identify "$data")"
    ui_email="$(json_email)"
    if [ -n "$tok_email" ] && [ -n "$ui_email" ] && [ "$tok_email" != "$ui_email" ]; then
      echo "claudeswitch: refusing to save — the active state is inconsistent." >&2
      echo "  Keychain token : $tok_email" >&2
      echo "  ~/.claude.json : $ui_email" >&2
      echo "  A running session likely refreshed the token. Quit Claude Code," >&2
      echo "  log in as the account you want to park, then retry." >&2
      exit 1
    fi

    [ -n "$tok_email" ] && echo "parking account: $tok_email"
    write_slot "${LIVE_SVC}-${name}" "$data"
    save_identity "$name"
    echo "saved to slot '$name'"
    printf '%s' "$data" | summarize
    ;;

  use)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch use <name>"
    # Check the slot exists before the session guard, so a typo reports the
    # typo rather than telling the user to quit their sessions for nothing.
    data="$(security find-generic-password -s "${LIVE_SVC}-${name}" -a "$ACCT" -w 2>/dev/null)" \
      || die "no slot '$name' — run 'claudeswitch save $name' while logged in as that account"
    assert_safe_to_switch
    write_slot "$LIVE_SVC" "$data"
    restore_identity "$name"
    echo "active account = slot '$name'"
    printf '%s' "$data" | summarize
    echo
    echo "note: restart Claude Code to pick this up."
    ;;

  list)
    echo "parked slots:"
    names="$(slot_names)"
    if [ -z "$names" ]; then
      echo "  (none — run 'claudeswitch save <name>' while logged in)"
    else
      while IFS= read -r s; do
        [ -n "$s" ] || continue
        sdata="$(security find-generic-password -s "${LIVE_SVC}-${s}" -a "$ACCT" -w 2>/dev/null || true)"
        semail="$(identify "$sdata")"
        idfile="$PARK_DIR/$s.oauthAccount.json"
        [ -f "$idfile" ] && idmark="" || idmark="   [no identity file — run 'save $s' again]"
        printf '  %-14s %s%s\n' "$s" "${semail:-(lookup failed — offline or token expired)}" "$idmark"
      done <<< "$names"
    fi
    echo
    echo "active account:"
    read_live | summarize
    ;;

  whoami)
    read_live | summarize
    ;;

  rm|remove|delete)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch rm <name>"
    security find-generic-password -s "${LIVE_SVC}-${name}" -a "$ACCT" >/dev/null 2>&1 \
      || die "no slot '$name'"
    security delete-generic-password -s "${LIVE_SVC}-${name}" -a "$ACCT" >/dev/null
    rm -f "$PARK_DIR/$name.oauthAccount.json"
    echo "removed slot '$name' (the active credential is untouched)"
    ;;

  install-shim)
    # Claude Code only puts a plugin's bin/ on PATH inside its own sessions.
    # But `use` requires Claude Code to be QUIT, so the command has to work in a
    # plain terminal too. This installs a tiny forwarder that locates whatever
    # plugin version is currently installed, so it survives plugin updates.
    target_dir="${1:-$HOME/.local/bin}"
    mkdir -p "$target_dir"
    shim="$target_dir/claudeswitch"

    if [ -e "$shim" ] && ! grep -q 'claudeswitch-shim' "$shim" 2>/dev/null; then
      die "$shim already exists and is not a claudeswitch shim — move it aside first"
    fi

    cat > "$shim" <<'SHIM'
#!/bin/bash
# claudeswitch-shim — forwards to the installed claudeswitch plugin.
# A plugin's bin/ is only on PATH inside Claude Code sessions, but switching
# accounts requires Claude Code to be quit. This makes the command available
# in any shell. Regenerate with: claudeswitch install-shim
# No `set -e` here: a failed lookup must fall through to the message below
# rather than exiting silently.
for root in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" "$HOME/.claude"; do
  # Newest version directory wins, so plugin updates need no reinstall.
  real="$(ls -1d "$root"/plugins/cache/claudeswitch/claudeswitch/*/bin/claudeswitch 2>/dev/null | sort -V | tail -1)"
  if [ -n "$real" ] && [ -x "$real" ]; then
    exec "$real" "$@"
  fi
done
echo "claudeswitch: plugin not found. Install it in Claude Code:" >&2
echo "  /plugin marketplace add https://github.com/realwebthings/claudeswitch" >&2
echo "  /plugin install claudeswitch" >&2
exit 1
SHIM
    chmod +x "$shim"
    echo "installed shim: $shim"

    case ":$PATH:" in
      *":$target_dir:"*) echo "$target_dir is already on your PATH — done." ;;
      *)
        echo
        echo "$target_dir is NOT on your PATH. Add this to your shell profile:"
        echo "  export PATH=\"$target_dir:\$PATH\""
        echo "then reload it (e.g. source ~/.zshrc)."
        ;;
    esac
    ;;

  help|--help|-h)
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
    ;;

  *)
    usage
    exit 1
    ;;
esac
