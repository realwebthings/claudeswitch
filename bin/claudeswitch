#!/bin/bash
# claudeswitch — switch between multiple Claude Code accounts without re-running
# /login every time.
#
#   claudeswitch save <name>     park the logged-in account under a slot name
#   claudeswitch use <name>      make a parked slot the active account
#   claudeswitch list            show parked slots and which is active
#   claudeswitch whoami          show the active account
#   claudeswitch rm <name>       delete a parked slot
#   claudeswitch update          update to the latest version
#
# Losing an account is the failure that costs a /login, so two guards are on by
# default: `use` parks the outgoing credential to "_previous" if it isn't already
# in a slot, and `save` refuses to overwrite a slot holding a different account.
# Both are bypassed with CLAUDESWITCH_FORCE=1.
#
# Why this is needed
# ------------------
# Logging in writes TWO pieces of state, and both must be swapped together:
#
#   1. OAuth tokens — where these live depends on the platform (see below).
#      /login overwrites them, destroying whichever account was there before.
#
#   2. The displayed identity — the "oauthAccount" key in ~/.claude.json.
#      Swap only the token and the UI keeps showing the previous email while
#      requests authenticate as the new account.
#
# Neither is scoped by CLAUDE_CONFIG_DIR: that env var swaps settings, plugins
# and history, but every config dir shares one credential store and one
# ~/.claude.json. So this script parks each account's token in its own slot plus
# an identity file, and copies the pair you want into place on demand.
#
#   <live credential>                 <- active; Claude Code reads only this
#   <slot copy named "<name>">        <- parked copy, survives /login
#   ~/.claude-accounts/<name>.oauthAccount.json
#
# Both parts are unofficial internals. A Claude Code update could rename either,
# so this script verifies what it finds and refuses to act on surprises rather
# than half-applying a switch.
#
# Platforms
# ---------
#   macOS         Keychain, via `security`. Service "Claude Code-credentials".
#   Linux / WSL   ~/.claude/.credentials.json, a mode-600 file. Slots are
#                 sibling files: ~/.claude-accounts/<name>.credentials.json
#   Windows       Same credentials file, under the Windows user profile. Needs a
#                 bash (Git Bash / MSYS). BEST-EFFORT: not verified on a real
#                 Windows install — if Claude Code there uses Credential Manager
#                 rather than a file, this reports that instead of guessing.
#
# Requires: curl, and on macOS the `security` command. No python required.

set -euo pipefail

LIVE_SVC="Claude Code-credentials"
# Keychain items are stored under the account name. $USER is not guaranteed to
# be exported (cron, minimal shells), so fall back to asking the system.
ACCT="${USER:-$(id -un)}"
# `set -u` would abort on an unset HOME (some cron/service environments), so
# resolve it from the password database instead of failing.
HOME="${HOME:-$(eval echo "~$ACCT")}"
GLOBAL_JSON="${HOME}/.claude.json"
PARK_DIR="${HOME}/.claude-accounts"
PROFILE_URL="https://api.anthropic.com/api/oauth/profile"
# Where the file-based backends keep the live credential. Honours
# CLAUDE_CONFIG_DIR because on these platforms the credential file lives *inside*
# the config dir, unlike the macOS Keychain which is global.
CONFIG_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
LIVE_FILE="$CONFIG_DIR/.credentials.json"

die() { echo "claudeswitch: $*" >&2; exit 1; }

assert_slot_name() {
  [ -n "$1" ] || die "slot name must not be empty"
  case "$1" in
    *[!A-Za-z0-9._-]*)
      die "slot name may only contain letters, digits, dot, dash, underscore" ;;
    .|..)
      die "slot name may not be '.' or '..'" ;;
    -*)
      die "slot name may not start with '-'" ;;
  esac
}

# ------------------------------------------------------------------ backend ---

detect_backend() {
  [ -n "${CLAUDESWITCH_BACKEND:-}" ] && { BACKEND="$CLAUDESWITCH_BACKEND"; return 0; }
  case "$(uname -s 2>/dev/null || echo unknown)" in
    Darwin)               BACKEND="keychain" ;;
    Linux)                BACKEND="file" ;;
    CYGWIN*|MINGW*|MSYS*) BACKEND="file" ;;
    *)                    BACKEND="file" ;;
  esac
}

require_deps() {
  command -v curl >/dev/null 2>&1 || die "curl not found"
  if [ "$BACKEND" = "keychain" ]; then
    command -v security >/dev/null 2>&1 \
      || die "'security' not found — expected on macOS. Set CLAUDESWITCH_BACKEND=file to use file storage."
  fi
}

assert_file_backend_usable() {
  [ -f "$LIVE_FILE" ] && return 0
  case "$(uname -s 2>/dev/null || echo unknown)" in
    CYGWIN*|MINGW*|MSYS*)
      die "no credential file at $LIVE_FILE.
  On Windows, claudeswitch supports Claude Code installs that store the token in
  that file. If your install keeps it in Windows Credential Manager instead,
  claudeswitch cannot switch accounts for it yet — please report your setup at
  https://github.com/realwebthings/claudeswitch/issues
  Running Claude Code under WSL is a supported alternative." ;;
    *)
      die "no credential file at $LIVE_FILE — open Claude Code and run /login first" ;;
  esac
}

# --- keychain (macOS) ---------------------------------------------------------

keychain_read_live() {
  security find-generic-password -s "$LIVE_SVC" -a "$ACCT" -w 2>/dev/null \
    || die "no active credential found — open Claude Code and run /login first"
}
keychain_read_slot()  { security find-generic-password -s "${LIVE_SVC}-$1" -a "$ACCT" -w 2>/dev/null; }
keychain_write_live() { security add-generic-password -U -s "$LIVE_SVC" -a "$ACCT" -w "$1"; }
keychain_write_slot() { security add-generic-password -U -s "${LIVE_SVC}-$1" -a "$ACCT" -w "$2"; }
keychain_slot_exists() {
  security find-generic-password -s "${LIVE_SVC}-$1" -a "$ACCT" >/dev/null 2>&1
}
keychain_delete_slot() {
  security delete-generic-password -s "${LIVE_SVC}-$1" -a "$ACCT" >/dev/null
}
keychain_slot_names() {
  security dump-keychain 2>/dev/null \
    | grep '"svce"' \
    | sed -n 's/.*"svce"<blob>="'"$LIVE_SVC"'-\(.*\)"/\1/p' \
    | sort -u
}

# --- file (Linux, WSL, Windows/Git Bash) --------------------------------------

file_slot_path() { echo "$PARK_DIR/$1.credentials.json"; }

file_read_live() {
  assert_file_backend_usable
  cat "$LIVE_FILE"
}
file_read_slot()   { cat "$(file_slot_path "$1")" 2>/dev/null; }

_file_write() {
  local dest="$1" data="$2" tmp
  tmp="$(dirname "$dest")/.claudeswitch.$$.tmp"
  ( umask 077; printf '%s' "$data" > "$tmp" )
  mv -f "$tmp" "$dest"
  chmod 600 "$dest" 2>/dev/null || true
}
file_write_live()  { _file_write "$LIVE_FILE" "$1"; }
file_write_slot()  { mkdir -p "$PARK_DIR"; chmod 700 "$PARK_DIR" 2>/dev/null || true; _file_write "$(file_slot_path "$1")" "$2"; }
file_slot_exists() { [ -f "$(file_slot_path "$1")" ]; }
file_delete_slot() { rm -f "$(file_slot_path "$1")"; }
file_slot_names()  {
  [ -d "$PARK_DIR" ] || return 0
  find "$PARK_DIR" -maxdepth 1 -name '*.credentials.json' 2>/dev/null \
    | sed 's#.*/##; s#\.credentials\.json$##' \
    | sort -u
}

# --- dispatch -----------------------------------------------------------------

read_live()   { "${BACKEND}_read_live"; }
read_slot()   { "${BACKEND}_read_slot" "$1"; }
write_live()  { "${BACKEND}_write_live" "$1"; }
write_slot()  { "${BACKEND}_write_slot" "$1" "$2"; }
slot_exists() { "${BACKEND}_slot_exists" "$1"; }
delete_slot() { "${BACKEND}_delete_slot" "$1"; }
slot_names()  { "${BACKEND}_slot_names"; }

# --------------------------------------------------------------- sessions -----

running_session_pids() {
  local pids="" p mine=""
  p=$$
  while [ -n "$p" ] && [ "$p" != "1" ]; do
    mine="$mine $p"
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
  local pat='native-binary/claude|/claude$|Claude\.app|claude-desktop|[Cc]laude\.exe'
  local found=""
  if command -v pgrep >/dev/null 2>&1; then
    found="$(pgrep -f "$pat" 2>/dev/null || true)"
  else
    found="$(ps -W 2>/dev/null | grep -Ei 'claude' | awk '{print $1}' || true)"
  fi
  for p in $found; do
    case " $mine " in *" $p "*) continue ;; esac
    pids="$pids $p"
  done
  echo "$pids" | tr -s ' ' | sed 's/^ //;s/ $//'
}

warn_other_sessions() {
  local pids; pids="$(running_session_pids)"
  [ -z "$pids" ] && return 0
  echo "claudeswitch: warning — other Claude Code sessions running (pid: $pids)." >&2
  echo "  They rewrite the active credential on token refresh. If a switch" >&2
  echo "  seems to revert, quit them and retry." >&2
}

assert_safe_to_switch() {
  local pids; pids="$(running_session_pids)"
  [ -z "$pids" ] && return 0

  if [ -n "${CLAUDESWITCH_FORCE:-}" ]; then
    echo "claudeswitch: force-killing Claude Code sessions (pid:$pids) ..."
    kill $pids 2>/dev/null || true
    sleep 1
    # hard kill anything still alive
    local still; still="$(running_session_pids)"
    [ -n "$still" ] && kill -9 $still 2>/dev/null || true
    return 0
  fi

  echo "claudeswitch: Claude Code is running (pid:$pids)."
  echo
  echo "  ⚠️  WARNING: Killing Claude Code will close all active sessions."
  echo "  Any unsaved work or ongoing tasks in Claude Code will be lost."
  echo
  printf "  Kill it and switch? [y/N] "
  # When piped (non-interactive), read from /dev/tty so the prompt works
  local reply
  if [ -t 0 ]; then
    read -r reply
  else
    read -r reply </dev/tty 2>/dev/null || reply="n"
  fi
  case "$reply" in
    [yY]*)
      echo "  Stopping Claude Code ..."
      kill $pids 2>/dev/null || true
      # wait up to 5s for graceful exit
      local i=0
      while [ $i -lt 10 ]; do
        sleep 0.5
        pids="$(running_session_pids)"
        [ -z "$pids" ] && break
        i=$(( i + 1 ))
      done
      # force-kill if still alive
      pids="$(running_session_pids)"
      [ -n "$pids" ] && { kill -9 $pids 2>/dev/null || true; sleep 0.5; }
      echo "  Stopped."
      ;;
    *)
      echo "claudeswitch: cancelled. Quit Claude Code manually and retry." >&2
      exit 1
      ;;
  esac
}

# ------------------------------------------------------------ JSON helpers ----
# Pure shell JSON extraction. The credential files are machine-written compact
# JSON — no multiline strings, no escaped quotes inside values we care about.
# These cover exactly the keys claudeswitch needs; nothing more.

# Extract a string value for a given key from a single-line JSON blob.
# Usage: json_get KEY <<< "$json"  or  echo "$json" | json_get KEY
# Handles both  "key":"value"  and  "key": "value"  spacing.
json_get() {
  grep -o "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" \
    | sed 's/.*"[^"]*"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/' \
    | head -1
}

# Extract a numeric value (no quotes) for a given key.
json_get_num() {
  grep -o "\"$1\"[[:space:]]*:[[:space:]]*[0-9]*" \
    | sed 's/.*:[[:space:]]*//' \
    | head -1
}

# Convert a Unix timestamp in milliseconds to "YYYY-MM-DD HH:MM" local time.
# Uses `date` which is available everywhere. Falls back to raw ms on failure.
ms_to_date() {
  local ms="$1"
  [ -n "$ms" ] && [ "$ms" != "0" ] || { echo "?"; return 0; }
  local secs=$(( ms / 1000 ))
  # macOS date uses -r <epoch>; GNU date uses -d @<epoch>
  if date -r "$secs" "+%Y-%m-%d %H:%M" 2>/dev/null; then
    return 0
  elif date -d "@$secs" "+%Y-%m-%d %H:%M" 2>/dev/null; then
    return 0
  else
    echo "?"
  fi
}

# ------------------------------------------------------------- credentials ----

# Extract the accessToken from a credential JSON blob.
token_of() {
  printf '%s' "$1" | json_get "accessToken" || true
}

# Resolve a credential blob to its account email via the API.
# Prints nothing on failure (offline, expired token, etc).
identify() {
  local tok
  tok="$(printf '%s' "$1" | json_get "accessToken")" || return 0
  [ -n "$tok" ] || return 0
  curl -s --max-time 10 \
    -H "Authorization: Bearer $tok" \
    -H "anthropic-beta: oauth-2025-04-20" \
    "$PROFILE_URL" 2>/dev/null \
    | json_get "email" || return 0
}

# Read emailAddress from the oauthAccount block in ~/.claude.json.
json_email() {
  [ -f "$GLOBAL_JSON" ] || return 0
  # The oauthAccount block is nested; grab emailAddress anywhere in the file —
  # it only appears once and always inside oauthAccount.
  grep -o '"emailAddress"[[:space:]]*:[[:space:]]*"[^"]*"' "$GLOBAL_JSON" 2>/dev/null \
    | sed 's/.*"emailAddress"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/' \
    | head -1 || true
}

summarize() {
  local data email plan tier access_ms refresh_ms
  data="$(cat)"
  [ -n "$data" ] || return 0
  email="$(identify "$data")"
  [ -n "$email" ] && echo "  account:  $email"
  plan="$(printf '%s' "$data"     | json_get "subscriptionType")"
  tier="$(printf '%s' "$data"     | json_get "rateLimitTier")"
  access_ms="$(printf '%s' "$data"  | json_get_num "expiresAt")"
  refresh_ms="$(printf '%s' "$data" | json_get_num "refreshTokenExpiresAt")"
  echo "  plan:     ${plan:-?} / ${tier:-?}"
  echo "  access:   $(ms_to_date "${access_ms:-0}")"
  echo "  refresh:  $(ms_to_date "${refresh_ms:-0}")"
}

# ---------------------------------------------------------------- identity ----

# Extract the oauthAccount JSON object from ~/.claude.json and write it to a
# file. Uses sed to pull everything between the first { } block after the key.
save_identity() {
  local name="$1"
  [ -f "$GLOBAL_JSON" ] || { echo "  (no ~/.claude.json — identity not parked)"; return 0; }
  mkdir -p "$PARK_DIR"
  chmod 700 "$PARK_DIR" 2>/dev/null || true

  # Pull the oauthAccount object. The value starts with { on the same line as
  # the key and ends with } before the next top-level key. sed range capture.
  local acct
  acct="$(sed -n '/"oauthAccount"[[:space:]]*:/,/^[[:space:]]*}/{ 
    /^[[:space:]]*"[a-zA-Z]/{ /oauthAccount/!q }
    p
  }' "$GLOBAL_JSON" 2>/dev/null \
    | sed -n '/oauthAccount/{s/.*"oauthAccount"[[:space:]]*:[[:space:]]*//;p}; /^[[:space:]]*[{}]/p' \
    | head -50 || true)"

  # Simpler fallback: grab the raw value with a single-pass grep for the block
  if [ -z "$acct" ]; then
    acct="$(grep -o '"oauthAccount"[[:space:]]*:[[:space:]]*{[^}]*}' "$GLOBAL_JSON" 2>/dev/null \
      | sed 's/.*"oauthAccount"[[:space:]]*:[[:space:]]*//' || true)"
  fi

  if [ -z "$acct" ]; then
    echo "  (no oauthAccount key in ~/.claude.json — identity not parked)"
    return 0
  fi

  local dest="$PARK_DIR/$name.oauthAccount.json"
  local tmp="$PARK_DIR/.claudeswitch.$$.tmp"
  ( umask 077; printf '%s\n' "$acct" > "$tmp" )
  mv -f "$tmp" "$dest"
  chmod 600 "$dest" 2>/dev/null || true
}

# Merge the parked oauthAccount object back into ~/.claude.json, replacing
# whatever is there. Backs up the file first and writes atomically.
restore_identity() {
  local name="$1"
  local parked="$PARK_DIR/$name.oauthAccount.json"
  if [ ! -f "$parked" ]; then
    echo "  warning: no parked identity for '$name' — the UI may still show the previous email."
    echo "           log in as that account and run 'claudeswitch save $name' to fix."
    return 0
  fi
  [ -f "$GLOBAL_JSON" ] || { echo "  warning: ~/.claude.json missing — identity not restored"; return 0; }

  local acct_json tmp
  acct_json="$(cat "$parked")"
  tmp="${GLOBAL_JSON}.claudeswitch.tmp"

  cp "$GLOBAL_JSON" "${GLOBAL_JSON}.claudeswitch.bak"

  # Replace the oauthAccount value in-place. The value is a {...} block.
  # Strategy: delete the old oauthAccount line+block, insert the new one.
  # Works for both compact  "oauthAccount":{...}  and pretty-printed forms.
  sed '/\"oauthAccount\"[[:space:]]*:/d' "$GLOBAL_JSON" > "$tmp"

  # Insert the new oauthAccount before the closing } of the top-level object.
  # Find the last } line and insert before it.
  local last_brace
  last_brace="$(grep -n '^}' "$tmp" | tail -1 | cut -d: -f1)"
  if [ -n "$last_brace" ]; then
    local before after
    before="$(head -n $(( last_brace - 1 )) "$tmp")"
    after="$(tail -n +"$last_brace" "$tmp")"
    # Add a comma to the previous last line if it doesn't already have one
    before="$(printf '%s' "$before" | sed '$ s/[^,{[]$/&,/')"
    printf '%s\n  "oauthAccount": %s\n%s\n' "$before" "$acct_json" "$after" > "$tmp"
  else
    # Fallback: just append (shouldn't happen with valid JSON)
    printf '  "oauthAccount": %s\n' "$acct_json" >> "$tmp"
  fi

  mv -f "$tmp" "$GLOBAL_JSON"
}

# --------------------------------------------------------------- auto-park ----

AUTOPARK_SLOT="_previous"

read_live_quiet() {
  case "$BACKEND" in
    keychain) security find-generic-password -s "$LIVE_SVC" -a "$ACCT" -w 2>/dev/null || true ;;
    *)        [ -f "$LIVE_FILE" ] && cat "$LIVE_FILE" 2>/dev/null || true ;;
  esac
}

# Read emailAddress from a parked identity file.
slot_identity_email() {
  local f="$PARK_DIR/$1.oauthAccount.json"
  [ -f "$f" ] || return 0
  grep -o '"emailAddress"[[:space:]]*:[[:space:]]*"[^"]*"' "$f" 2>/dev/null \
    | sed 's/.*"emailAddress"[[:space:]]*:[[:space:]]*"\([^"]*\)"/\1/' \
    | head -1 || true
}

live_is_parked() {
  local data="$1" live_tok live_email slot stok semail
  live_tok="$(token_of "$data")"
  [ -n "$live_tok" ] || return 1

  live_email="$(json_email)"
  [ -n "$live_email" ] || live_email="$(identify "$data")"

  while IFS= read -r slot; do
    [ -n "$slot" ] || continue
    stok="$(token_of "$(read_slot "$slot" 2>/dev/null || true)")"
    [ -n "$stok" ] && [ "$stok" = "$live_tok" ] && { echo "$slot"; return 0; }
    if [ -n "$live_email" ]; then
      semail="$(slot_identity_email "$slot")"
      [ -n "$semail" ] && [ "$semail" = "$live_email" ] && { echo "$slot"; return 0; }
    fi
  done <<< "$(slot_names)"
  return 1
}

autopark_outgoing() {
  local data existing
  data="$(read_live_quiet)"
  [ -n "$data" ] || return 0
  if existing="$(live_is_parked "$data")"; then
    echo "  (outgoing account already parked as '$existing')"
    return 0
  fi
  write_slot "$AUTOPARK_SLOT" "$data"
  save_identity "$AUTOPARK_SLOT" >/dev/null 2>&1 || true
  echo "  parked outgoing account to '$AUTOPARK_SLOT' (recover with: claudeswitch use $AUTOPARK_SLOT)"
}

# ---------------------------------------------------------------- commands ----

usage() {
  local last
  last="$(grep -n '^#   claudeswitch ' "$0" | tail -1 | cut -d: -f1)"
  sed -n "2,${last}p" "$0" | sed 's/^# \{0,1\}//'
  echo
  echo "Run 'claudeswitch help' for the full explanation."
}

detect_backend
require_deps
cmd="${1:-}"; shift || true

case "$cmd" in
  save)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch save <name>"
    assert_slot_name "$name"
    warn_other_sessions
    data="$(read_live)"

    tok_email="$(identify "$data")"
    ui_email="$(json_email)"
    if [ -n "$tok_email" ] && [ -n "$ui_email" ] && [ "$tok_email" != "$ui_email" ]; then
      echo "claudeswitch: refusing to save — the active state is inconsistent." >&2
      echo "  stored token   : $tok_email" >&2
      echo "  ~/.claude.json : $ui_email" >&2
      echo "  A running session likely refreshed the token. Quit Claude Code," >&2
      echo "  log in as the account you want to park, then retry." >&2
      exit 1
    fi

    if slot_exists "$name" && [ -z "${CLAUDESWITCH_FORCE:-}" ]; then
      old_email="$(identify "$(read_slot "$name" 2>/dev/null || true)")"
      if [ -n "$old_email" ] && [ -n "$tok_email" ] && [ "$old_email" != "$tok_email" ]; then
        echo "claudeswitch: refusing to overwrite slot '$name' — it holds a different account." >&2
        echo "  slot '$name' : $old_email" >&2
        echo "  active now   : $tok_email" >&2
        echo "  Overwriting destroys $old_email's token; it would need a fresh /login." >&2
        echo "  Pick another slot name, or force it:" >&2
        echo "    CLAUDESWITCH_FORCE=1 claudeswitch save $name" >&2
        exit 1
      fi
    fi

    [ -n "$tok_email" ] && echo "parking account: $tok_email"
    write_slot "$name" "$data"
    save_identity "$name"
    echo "saved to slot '$name'"
    printf '%s' "$data" | summarize
    ;;

  use)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch use <name>"
    assert_slot_name "$name"
    slot_exists "$name" \
      || die "no slot '$name' — run 'claudeswitch save $name' while logged in as that account"
    data="$(read_slot "$name")"
    [ -n "$data" ] || die "slot '$name' is empty or unreadable — re-park it with 'claudeswitch save $name'"
    assert_safe_to_switch
    if [ "$name" != "$AUTOPARK_SLOT" ]; then
      autopark_outgoing
    fi
    write_live "$data"
    restore_identity "$name"
    echo "active account = slot '$name'"
    printf '%s' "$data" | summarize
    echo
    echo "note: open Claude Code to start using this account."
    ;;

  list)
    echo "parked slots:"
    names="$(slot_names)"
    if [ -z "$names" ]; then
      echo "  (none — run 'claudeswitch save <name>' while logged in)"
    else
      while IFS= read -r s; do
        [ -n "$s" ] || continue
        sdata="$(read_slot "$s" 2>/dev/null || true)"
        semail="$(identify "$sdata")"
        idfile="$PARK_DIR/$s.oauthAccount.json"
        [ -f "$idfile" ] && idmark="" || idmark="   [no identity file — run 'save $s' again]"
        printf '  %-14s %s%s\n' "$s" "${semail:-(lookup failed — offline or token expired)}" "$idmark"
      done <<< "$names"
    fi
    echo
    echo "active account:"
    read_live | summarize
    ;;

  whoami)
    live="$(read_live)" || exit 1
    printf '%s' "$live" | summarize
    ;;

  rm|remove|delete)
    name="${1:-}"; [ -n "$name" ] || die "usage: claudeswitch rm <name>"
    assert_slot_name "$name"
    slot_exists "$name" || die "no slot '$name'"
    delete_slot "$name"
    rm -f "$PARK_DIR/$name.oauthAccount.json"
    echo "removed slot '$name' (the active credential is untouched)"
    ;;

  update)
    curl -fsSL "https://raw.githubusercontent.com/realwebthings/claudeswitch/main/install.sh" \
      | bash -s -- "${1:-}"
    ;;

  help|--help|-h)
    sed -n '2,/^set -euo pipefail$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
    ;;

  *)
    usage
    exit 1
    ;;
esac
